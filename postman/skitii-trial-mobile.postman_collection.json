    {
      "name": "Offline sync (GraphQL)",
      "description": "Tablet `syncTablet` mutation. Every tablet request must send `x-device-id` = a device registered and active for the institution in product `physical_devices`; `input.physicalDeviceId` must match the header.\n\nResponse: `applied[]`, `failures[]` (`code`, `message`, `retryable`), legacy `failed`, `patients` (only this tablet's), `removedPatientIds`, `fullSnapshot`, `trialConfigVersion`, `serverNow`. Save `serverNow` and send it as `since` next time.",
      "item": [
        {
          "name": "syncTablet — first pull (full device snapshot)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apollo-require-preflight",
                "value": "true"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($input: JSON!) {\n  syncTablet(input: $input)\n}",
                "variables": "{\n  \"input\": {\n    \"physicalDeviceId\": \"{{deviceId}}\",\n    \"operations\": []\n  }\n}"
              }
            },
            "url": "{{trialApiUrl}}/graphql",
            "description": "No `since` → full snapshot of patients assigned to this tablet. Saves `serverNow` to `{{since}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(j.errors, JSON.stringify(j.errors)).to.be.undefined);",
                  "const r = j.data && j.data.syncTablet;",
                  "pm.test('full snapshot', () => pm.expect(r.fullSnapshot).to.eql(true));",
                  "if (r && r.serverNow) pm.collectionVariables.set('since', r.serverNow);"
                ]
              }
            }
          ]
        },
        {
          "name": "syncTablet — incremental pull (since)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apollo-require-preflight",
                "value": "true"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($input: JSON!) {\n  syncTablet(input: $input)\n}",
                "variables": "{\n  \"input\": {\n    \"physicalDeviceId\": \"{{deviceId}}\",\n    \"since\": \"{{since}}\",\n    \"operations\": []\n  }\n}"
              }
            },
            "url": "{{trialApiUrl}}/graphql",
            "description": "Only rows changed after `since`, plus `removedPatientIds` for patients transferred away from this tablet since then."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(j.errors, JSON.stringify(j.errors)).to.be.undefined);",
                  "const r = j.data && j.data.syncTablet;",
                  "pm.test('has removedPatientIds', () => pm.expect(r).to.have.property('removedPatientIds'));",
                  "if (r && r.serverNow) pm.collectionVariables.set('since', r.serverNow);"
                ]
              }
            }
          ]
        },
        {
          "name": "syncTablet — replay an offline createPatient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apollo-require-preflight",
                "value": "true"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($input: JSON!) {\n  syncTablet(input: $input)\n}",
                "variables": "{\n  \"input\": {\n    \"physicalDeviceId\": \"{{deviceId}}\",\n    \"since\": \"{{since}}\",\n    \"operations\": [\n      {\n        \"type\": \"createPatient\",\n        \"clientMutationId\": \"{{$guid}}\",\n        \"clientOccurredAt\": \"{{$isoTimestamp}}\",\n        \"variables\": {\n          \"input\": {\n            \"firstName\": \"Offline\",\n            \"lastName\": \"Patient\",\n            \"registrationNo\": \"OFF-{{$timestamp}}\",\n            \"age\": 45,\n            \"gender\": \"female\",\n            \"emergencyNumber\": \"9000000000\",\n            \"languagePreference\": \"English\",\n            \"enrollmentDate\": \"2026-10-01\",\n            \"groupType\": \"control\",\n            \"diagnosisStage\": \"Stage 2\",\n            \"treatmentType\": \"Radiotherapy\",\n            \"cancerSite\": \"Oral\",\n            \"ecogScore\": \"1\",\n            \"surgicalType\": \"Pre-Operative\",\n            \"ancovaStaging\": \"Early\",\n            \"_localId\": \"local-{{$timestamp}}\"\n          }\n        }\n      }\n    ]\n  }\n}"
              }
            },
            "url": "{{trialApiUrl}}/graphql",
            "description": "One outbox operation. `clientOccurredAt` is validated against server time: at most 2 minutes in the future and no older than `OFFLINE_SYNC_MAX_AGE_HOURS` (default 72). Replaying the same `clientMutationId` returns the same record. Operations depending on a failed one come back as `DEPENDENCY_FAILED`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('no GraphQL errors', () => pm.expect(j.errors, JSON.stringify(j.errors)).to.be.undefined);",
                  "const r = j.data && j.data.syncTablet;",
                  "pm.test('applied or reported', () => pm.expect(r.applied.length + (r.failures || []).length).to.be.above(0));",
                  "if (r.applied[0] && r.applied[0].serverId) pm.collectionVariables.set('patientId', r.applied[0].serverId);"
                ]
              }
            }
          ]
        },

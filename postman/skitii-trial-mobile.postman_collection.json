                  "const j = pm.response.json();",
                  "pm.test('has items/total/date', () => {",
                  "  pm.expect(j).to.have.property('items');",
                  "  pm.expect(j).to.have.property('total');",
                  "  pm.expect(j).to.have.property('date');",
                  "});",
                  "if (Array.isArray(j.items) && j.items[0]?._id) {",
                  "  pm.collectionVariables.set('patientId', j.items[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?page=1&limit=20",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }

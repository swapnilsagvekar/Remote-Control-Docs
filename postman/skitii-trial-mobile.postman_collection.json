    },
    {
      "name": "Patients — Scenario notes (seed SCN-*)",
      "description": "After `npm run seed` in Trial Backend, registrationNos map to dashboard scenarios:\n\n| Reg No | Scenario |\n|---|---|\n| SCN-W0-NS | Week 0 not submitted |\n| SCN-PRE-ENR | Before enrollment |\n| SCN-START | Pending Start |\n| SCN-RESUME | Active → Resume |\n| SCN-DONE | Session Done |\n| SCN-RESTART | Incomplete → Restart |\n| SCN-ALL-MISS | All shifts missed (clock-dependent) |\n| SCN-W2-PEND | Week 2 pending |\n| SCN-W2-MISS | Week 2 missed |\n| SCN-W-DONE | All weekly done |\n| SCN-TRIAL-DONE | Trial completed |\n| SCN-W0-GAP | Week 0 missed gap |\n\nUse **List — search** with e.g. `Week0` / `Pending` / `Resume` to isolate them.",
      "item": [
        {
          "name": "Search SCN-W0-NS (Week0 not submitted)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?search=NotSubmitted",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [{ "key": "search", "value": "NotSubmitted" }]
            }
          }
        },
        {
          "name": "Search SCN-START (pending start)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?search=Start&sessionStatus=pending",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "search", "value": "Start" },
                { "key": "sessionStatus", "value": "pending" }
              ]
            }
          }
        },
        {
          "name": "Search SCN-RESUME",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?search=Resume",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [{ "key": "search", "value": "Resume" }]
            }
          }
        },
        {
          "name": "Search SCN-DONE + completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?search=Done&sessionStatus=completed",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "search", "value": "Done" },
                { "key": "sessionStatus", "value": "completed" }
              ]
            }
          }
        },
        {
          "name": "Search weekly pending Week2",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{trialApiUrl}}/patients?search=Week2&weekly=Weekly%20Pending",
              "host": ["{{trialApiUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "search", "value": "Week2" },
                { "key": "weekly", "value": "Weekly Pending" }
              ]
            }
